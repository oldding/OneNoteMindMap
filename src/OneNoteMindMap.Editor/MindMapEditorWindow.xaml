<Window x:Class="OneNoteMindMap.Editor.MindMapEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneNote Mind Map Editor"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,4">
            <WrapPanel>
                <Button x:Name="BtnAddSibling" Style="{StaticResource ToolbarButton}" Click="AddSibling_Click">添加同级</Button>
                <Button x:Name="BtnAddChild" Style="{StaticResource ToolbarButton}" Click="AddChild_Click">添加子节点</Button>
                <Button x:Name="BtnDelete" Style="{StaticResource ToolbarButton}" Click="DeleteNode_Click">删除</Button>
                <Separator Width="1" Height="20" Background="#CCCCCC" Margin="4,0"/>
                <Button x:Name="BtnCollapse" Style="{StaticResource ToolbarButton}" Click="CollapseToggle_Click">折叠/展开</Button>
                <Separator Width="1" Height="20" Background="#CCCCCC" Margin="4,0"/>
                <Button x:Name="BtnSave" Style="{StaticResource ToolbarButton}" Click="Save_Click">保存</Button>
                <Button x:Name="BtnExportPng" Style="{StaticResource ToolbarButton}" Click="ExportPng_Click">导出 PNG</Button>
                <Button x:Name="BtnExportSvg" Style="{StaticResource ToolbarButton}" Click="ExportSvg_Click">导出 SVG</Button>
                <Separator Width="1" Height="20" Background="#CCCCCC" Margin="4,0"/>
                <Label x:Name="LblLayout" Content="布局:" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="LayoutCombo" SelectedIndex="0" Width="110" VerticalAlignment="Center" SelectionChanged="Layout_Changed" InputMethod.IsInputMethodEnabled="False">
                    <ComboBoxItem Tag="RightTree">右侧树形</ComboBoxItem>
                    <ComboBoxItem Tag="BothSides">两侧分布</ComboBoxItem>
                    <ComboBoxItem Tag="OrgChart">组织结构图</ComboBoxItem>
                </ComboBox>
                <Label x:Name="LblTheme" Content="主题:" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="ThemeCombo" SelectedIndex="0" Width="100" VerticalAlignment="Center" SelectionChanged="Theme_Changed" InputMethod.IsInputMethodEnabled="False">
                    <ComboBoxItem Tag="Default">默认</ComboBoxItem>
                    <ComboBoxItem Tag="Purple">紫色</ComboBoxItem>
                    <ComboBoxItem Tag="Minimal">简约</ComboBoxItem>
                    <ComboBoxItem Tag="Fresh">清新</ComboBoxItem>
                    <ComboBoxItem Tag="Warm">暖色</ComboBoxItem>
                </ComboBox>
                <Label x:Name="LblShape" Content="形状:" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="ShapeCombo" SelectedIndex="0" Width="90" VerticalAlignment="Center" SelectionChanged="Shape_Changed" InputMethod.IsInputMethodEnabled="False">
                    <ComboBoxItem Tag="Rounded">圆角</ComboBoxItem>
                    <ComboBoxItem Tag="Rectangle">矩形</ComboBoxItem>
                    <ComboBoxItem Tag="Pill">胶囊</ComboBoxItem>
                </ComboBox>
                <Label x:Name="LblConnection" Content="连接线:" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="ConnectionCombo" SelectedIndex="0" Width="110" VerticalAlignment="Center" SelectionChanged="Connection_Changed" InputMethod.IsInputMethodEnabled="False">
                    <ComboBoxItem Tag="Curved">曲线</ComboBoxItem>
                    <ComboBoxItem Tag="Straight">直线</ComboBoxItem>
                    <ComboBoxItem Tag="Orthogonal">折线</ComboBoxItem>
                    <ComboBoxItem Tag="ClassicMindMap">经典脑图</ComboBoxItem>
                </ComboBox>
                <Label x:Name="LblEndpoint" Content="端点:" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="EndpointCombo" SelectedIndex="0" Width="100" VerticalAlignment="Center" SelectionChanged="Endpoint_Changed" InputMethod.IsInputMethodEnabled="False">
                    <ComboBoxItem Tag="None">无</ComboBoxItem>
                    <ComboBoxItem Tag="Arrow">箭头</ComboBoxItem>
                    <ComboBoxItem Tag="DoubleArrow">双向箭头</ComboBoxItem>
                    <ComboBoxItem Tag="Circle">圆点</ComboBoxItem>
                    <ComboBoxItem Tag="Diamond">菱形</ComboBoxItem>
                </ComboBox>
            </WrapPanel>
        </Border>

        <!-- Canvas area -->
        <Border Grid.Row="1" Background="#FFFFFF" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="MainCanvas" Background="#FFFFFF"
                        MouseDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseUp="Canvas_MouseUp"
                        MouseWheel="Canvas_MouseWheel">
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="ZoomTransform"/>
                    </Canvas.LayoutTransform>
                </Canvas>
            </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#0078D4" Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" FontSize="12"/>
                <TextBlock Grid.Column="1" x:Name="ZoomText" Text="100%" Foreground="White" FontSize="12" Margin="0,0,8,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
